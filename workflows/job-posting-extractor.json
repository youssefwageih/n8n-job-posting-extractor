    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"isJobPosting\":{\"type\":\"boolean\",\"description\":\"false if the text is not a job posting\"},\"jobTitle\":{\"type\":\"string\"},\"pay\":{\"type\":\"string\"},\"toolsSkills\":{\"type\":\"string\"},\"education\":{\"type\":\"string\"},\"experience\":{\"type\":\"string\"},\"other\":{\"type\":\"string\",\"description\":\"Empty string if none\"},\"keyTasks\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"note\":{\"type\":\"string\",\"description\":\"Short note on vague or contradictory info, else empty string\"},\"fitVerdict\":{\"type\":\"string\",\"enum\":[\"Fit\",\"Partial fit\",\"Miss\",\"No CV\"]},\"fitMatches\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"fitGaps\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"isJobPosting\",\"jobTitle\",\"pay\",\"toolsSkills\",\"education\",\"experience\",\"other\",\"keyTasks\",\"note\",\"fitVerdict\",\"fitMatches\",\"fitGaps\"]}"
      },
