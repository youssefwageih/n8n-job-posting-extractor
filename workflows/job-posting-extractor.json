              "type": "string"
            },
            {
              "id": "f-exp",
              "name": "Experience",
              "value": "={{ $json.output.experience || \"Not stated\" }}",
              "type": "string"
            },
            {
              "id": "f-other",
              "name": "Other",
              "value": "={{ $json.output.other || \"\" }}",
              "type": "string"
            },
            {
              "id": "f-tasks",
              "name": "Key Tasks",
              "value": "={{ ($json.output.keyTasks || []).map(t => \"• \" + t).join(\"\\n\") }}",
              "type": "string"
            },
            {
              "id": "f-note",
              "name": "Notes",
              "value": "={{ $json.output.note || \"\" }}",
              "type": "string"
            },
            {
              "id": "f-cvfit",
              "name": "CV Fit",
              "value": "={{ ($json.output.fitVerdict || \"No CV\") + (($json.output.fitGaps || []).length ? \" | Gaps: \" + $json.output.fitGaps.join(\", \") : \"\") }}",
              "type": "string"
            },
            {
              "id": "f-link",
              "name": "Link",
              "value": "={{ ($('Telegram Trigger').item.json.message.text.match(/https?:\\/\\/\\S+/) || [''])[0] }}",
              "type": "string"
            },
            {
              "id": "f-msg",
              "name": "telegramMessage",
              "value": "={{ (() => {\n  const o = $json.output;\n  const e = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const lines = [];\n  lines.push('<b>Job Title:</b> ' + e(o.jobTitle));\n  lines.push('');\n  lines.push('<b>Pay:</b> ' + e(o.pay || 'Not stated'));\n  lines.push('');\n  lines.push('<b>Requirements:</b>');\n  lines.push('- Tools &amp; skills: ' + e(o.toolsSkills || 'Not stated'));\n  lines.push('- Education: ' + e(o.education || 'Not stated'));\n  lines.push('- Experience: ' + e(o.experience || 'Not stated'));\n  if (o.other && o.other.trim()) lines.push('- Other: ' + e(o.other));\n  lines.push('');\n  lines.push('<b>Key Tasks:</b>');\n  (o.keyTasks || []).forEach((t) => lines.push('- ' + e(t)));\n  if (o.note && o.note.trim()) { lines.push(''); lines.push('<i>Note: ' + e(o.note) + '</i>'); }\n  lines.push('');\n  if (!o.fitVerdict || o.fitVerdict === 'No CV') {\n    lines.push('<b>CV Match:</b> No CV on file. Send your CV as a PDF to get a fit check.');\n  } else {\n    lines.push('<b>CV Match:</b> ' + e(o.fitVerdict));\n    if ((o.fitMatches || []).length) lines.push('- Matches: ' + e(o.fitMatches.join(', ')));\n    if ((o.fitGaps || []).length) lines.push('- Gaps: ' + e(o.fitGaps.join(', ')));\n  }\n  return lines.join('\\n');\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
